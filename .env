# =============================================================================
# Database Tables Reference (public schema)
# -----------------------------------------------------------------------------
# elnota_accounts         — Account identity, activation, subscription, printing
# elnota_requests         — Activation/subscription payment review requests
# elnota_cloud            — Latest synchronized ledger document and revision
# elnota_backups          — Historical synchronized ledger snapshots
# elnota_daily_backups    — Latest daily server ledger snapshot per account
# elnota_device_backup_files — Device snapshot files, capture/upload times
# elnota_catalog_imports  — Account-specific catalog import documents
# =============================================================================

# Public RPCs available via supabase.rpc(...)
# -----------------------------------------------------------------------------
# elnota_register(business text)                              → elnota_accounts
# elnota_sync(payload jsonb, expected_revision bigint)        → bigint
# elnota_manage_cloud(target_user uuid, plan text)            → timestamptz
# elnota_restore_daily(target_user uuid, expected_revision)   → bigint
# elnota_upload_device_backup(...)                            → jsonb
# elnota_daily_snapshot()                                     → timestamptz
# elnota_is_admin()                                           → boolean
# elnota_manage_account(target_user uuid, operation text)     → void
# elnota_review(request_id uuid, approve boolean)             → void
# elnota_set_printing(target_user uuid, enabled boolean)      → void
# =============================================================================
